# Copy to .env and fill in. Only the keys below are needed; MONGO_URI is set by
# docker-compose, so leave it out unless you run the backend outside Docker.

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=1440

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Vector store — https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=pdfgpt

# Chat model — https://console.groq.com
GROQ_API_KEY=

# OCR for scanned images/PDFs — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: profile picture uploads. Leave blank to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
